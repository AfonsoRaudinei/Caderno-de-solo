rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function keepsUserId(uid) {
      return request.resource.data.userId == uid;
    }

    function currentUserIdMatches(uid) {
      return resource.data.userId == uid;
    }

    // Permite GET de documento ainda inexistente (resource == null)
    // para o handshake de idempotência do save em lote.
    // Para docs existentes, mantém ownership por userId.
    function currentUserIdMatchesOrMissing(uid) {
      return resource == null || resource.data.userId == uid;
    }

    function keepsClienteOwner(uid) {
      return request.resource.data.usuarioId == uid;
    }

    function clienteOwner(clienteId) {
      return get(/databases/$(database)/documents/clientes/$(clienteId)).data.usuarioId == request.auth.uid;
    }

    // Perfil do usuário e subcoleções privadas.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /calibracoes/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /laudos/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Análises principais.
    match /analises/{analiseId} {
      allow create: if signedIn() && keepsUserId(request.auth.uid);
      allow read: if signedIn() && currentUserIdMatchesOrMissing(request.auth.uid);
      allow delete: if signedIn() && currentUserIdMatches(request.auth.uid);
      allow update: if signedIn() &&
          currentUserIdMatches(request.auth.uid) &&
          keepsUserId(request.auth.uid);
    }

    // Controle de lotes/idempotência.
    match /analise_save_batches/{batchId} {
      allow create: if signedIn() && keepsUserId(request.auth.uid);
      allow read: if signedIn() && currentUserIdMatchesOrMissing(request.auth.uid);
      allow delete: if signedIn() && currentUserIdMatches(request.auth.uid);
      allow update: if signedIn() &&
          currentUserIdMatches(request.auth.uid) &&
          keepsUserId(request.auth.uid);
    }

    // Recomendações
    match /recomendacoes/{docId} {
      allow create: if signedIn() && keepsUserId(request.auth.uid);
      allow read: if signedIn() && currentUserIdMatchesOrMissing(request.auth.uid);
      allow delete: if signedIn() && currentUserIdMatches(request.auth.uid);
      allow update: if signedIn() &&
          currentUserIdMatches(request.auth.uid) &&
          keepsUserId(request.auth.uid);
    }

    match /clientes/{clienteId} {
      allow create: if signedIn() && keepsClienteOwner(request.auth.uid);
      // get: dono OU cliente com token registrado (App Mapa após lookup).
      allow get: if signedIn() && (
          resource.data.usuarioId == request.auth.uid ||
          (resource.data.token is string &&
            exists(/databases/$(database)/documents/cliente_tokens/$(resource.data.token)))
        );
      // list: somente dono — queries devem filtrar usuarioId.
      allow list: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow delete: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow update: if signedIn() &&
          resource.data.usuarioId == request.auth.uid &&
          keepsClienteOwner(request.auth.uid);

      match /fazendas/{fazendaId} {
        allow read, write: if signedIn() && clienteOwner(clienteId);

        match /talhoes/{talhaoId} {
          allow read, write: if signedIn() && clienteOwner(clienteId);
        }
      }
    }

    // Registro de tokens SF-AAAA-XXXX para lookup pontual (App Mapa).
    // Usa get por documentId — não exige query collection-wide em `clientes`.
    match /cliente_tokens/{token} {
      allow get: if signedIn();
      allow create: if signedIn() &&
          request.resource.data.usuarioId == request.auth.uid &&
          request.resource.data.keys().hasAll(['clienteId', 'usuarioId', 'token']);
      allow update: if signedIn() &&
          resource.data.usuarioId == request.auth.uid &&
          request.resource.data.usuarioId == request.auth.uid;
      allow delete: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow list: if false;
    }
  }
}
